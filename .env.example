# Contact form delivery (https://resend.com). Without these, dev saves to data/inquiries.jsonl only.
RESEND_API_KEY=
# One address, or several separated by commas.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Triviq <hello@your-verified-domain.com>

# Optional confirmation email to the person who wrote in. Set to 1 only with a verified CONTACT_FROM_EMAIL:
# the Resend sandbox sender cannot mail strangers, and the form skips the confirmation without CONTACT_FROM_EMAIL.
CONTACT_AUTOREPLY=

# Analytics are OFF until this is set at build time (cookieless Plausible). The privacy page text follows this flag.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only for a self-hosted or proxied Plausible script. Default: https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
